    {
        "id": "15221b97a796e42e",
        "type": "function",
        "z": "tab_home_v2",
        "d": true,
        "name": "function 3",
        "func": "// 1. Gelen USB mesajını yazıya çevir\nvar gelenVeri = msg.payload.toString();\n\n// 2. Eğer içinde \"Temperature\" yazıyorsa\nif (gelenVeri.includes(\"Temperature\")) {\n    // Yazıyı parçala ve sadece sayıyı al (Örn: 22.5)\n    var sicaklik = gelenVeri.split(\"Temperature(\")[1].split(\",\")[0];\n    \n    // Bunu sayı formatına çevir (Grafiklerin çalışması için şart!)\n    msg.payload = parseFloat(sicaklik);\n    \n    // Okul sunucusu için etiket yapıştır\n    msg.topic = \"ProIT_IoT/Yigit/temp\";\n    \n    return msg;\n}\n\n// 3. Eğer içinde \"Humidity\" yazıyorsa\nif (gelenVeri.includes(\"Humidity\")) {\n    var nem = gelenVeri.split(\"Humidity(\")[1].split(\",\")[0];\n    msg.payload = parseFloat(nem);\n    msg.topic = \"ProIT_IoT/Yigit/humi\";\n    return msg;\n}\n\nreturn null;",
