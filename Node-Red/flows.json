    {
        "id": "win_anim_v2",
        "type": "ui_template",
        "z": "tab_eco_v2",
        "group": "grp_sys_stat",
        "name": "WINDOW ANIM",
        "order": 2,
        "width": 0,
        "height": 0,
        "format": "<div id=\"win-dev\"\n    style=\"text-align:center;padding:20px;border:3px solid #334155;border-radius:15px;background:#1e293b;transition:all 0.5s ease;\">\n    <h3 style=\"color:#94a3b8;\">AUTOMATIC WINDOW</h3>\n    <i id=\"fan-icon\" class=\"fa fa-snowflake-o fa-4x\" style=\"color:#334155;transition:all 0.5s;\"></i>\n    <h3 id=\"win-status\" style=\"color:#64748b;margin-top:15px;\">CLOSED</h3>\n</div>\n<script>\n    (function(scope){scope.$watch('msg',function(msg){if(msg&&msg.payload){var dev=document.getElementById('win-dev');var fan=document.getElementById('fan-icon');var txt=document.getElementById('win-status');if(msg.payload===\"OPEN\"){dev.style.border=\"3px solid #38bdf8\";fan.style.color=\"#38bdf8\";fan.classList.add(\"fa-spin\");txt.innerHTML=\"⚠️ OPEN (COOLING)\";txt.style.color=\"#38bdf8\";}else{dev.style.border=\"3px solid #334155\";fan.style.color=\"#334155\";fan.classList.remove(\"fa-spin\");txt.innerHTML=\"KAPALI\";txt.style.color=\"#64748b\";}}});})(scope);\n</script>",
