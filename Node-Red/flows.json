    {
        "id": "usb_parser_v2",
        "type": "function",
        "z": "tab_home_v2",
        "name": "DATA PARSER",
        "func": "// Convert incoming data to string\nvar raw = msg.payload.toString();\n\n// ---------------------------------------------------------\n// 1. TEMPERATURE\n// ---------------------------------------------------------\nif (raw.includes(\"Temperature\")) {\n    // Extract the number: \"Temperature(22.5, ...)\" -> 22.5\n    var t = raw.split(\"Temperature(\")[1].split(\",\")[0];\n    \n    msg.payload = parseFloat(t);\n    msg.topic = \"temp_real\"; // The \"GATE: TEMP\" node expects this topic\n    \n    // Send to Output 1, Nothing to Output 2\n    return [msg, null]; \n}\n\n// ---------------------------------------------------------\n// 2. HUMIDITY\n// ---------------------------------------------------------\nif (raw.includes(\"Humidity\")) {\n    // Extract the number: \"Humidity(45.2, ...)\" -> 45.2\n    var h = raw.split(\"Humidity(\")[1].split(\",\")[0];\n    \n    msg.payload = parseFloat(h);\n    msg.topic = \"humi_real\"; // The \"GATE: HUMI\" node expects this topic\n    \n    // Nothing to Output 1, Send to Output 2\n    return [null, msg];\n}\n\n// If data is unknown, do nothing\nreturn [null, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 180,
        "wires": [
            [
                "gate_temp_v2"
            ],
            [
                "gate_humi_v2"
            ]
        ]
    },
    {
        "id": "gate_temp_v2",
        "type": "function",
        "z": "tab_home_v2",
        "name": "GATE: TEMP",
        "func": "var mode = global.get(\"sim_mode\") || false;\nvar simVal = global.get(\"sim_temp\");\n\nif (mode) {\n    if (msg.topic === \"sim_update\") {\n        msg.payload = simVal;\n        return msg;\n    }\n    return null;\n} else {\n    if (msg.topic === \"temp_real\") {\n        return msg;\n    }\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 160,
        "wires": [
            [
                "gauge_temp_v2",
                "mqtt_out_temp_v2",
                "link_to_brain_v2"
            ]
        ]
    },
    {
        "id": "gate_humi_v2",
        "type": "function",
        "z": "tab_home_v2",
        "name": "GATE: HUMI",
        "func": "var mode = global.get(\"sim_mode\") || false;\nvar simVal = global.get(\"sim_humi\");\n\nif (mode) {\n    if (msg.topic === \"sim_update\") {\n        msg.payload = simVal;\n        return msg;\n    }\n    return null;\n} else {\n    if (msg.topic === \"humi_real\") {\n        return msg;\n    }\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 240,
        "wires": [
            [
                "gauge_humi_v2",
                "mqtt_out_humi_v2"
            ]
        ]
    },
