        "type": "function",
        "z": "tab_eco_v2",
        "name": "SIM CONTROLLER",
        "func": "if (msg.topic === \"sim_switch\") global.set(\"sim_mode\", msg.payload);\nif (msg.topic === \"sim_temp\") global.set(\"sim_temp\", msg.payload);\nif (msg.topic === \"sim_humi\") global.set(\"sim_humi\", msg.payload);\n\nvar mode = global.get(\"sim_mode\");\nif (mode) {\n    return { payload: \"UPDATE\", topic: \"sim_update\" };\n}\nreturn null;",
